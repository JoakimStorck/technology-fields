# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Regenerable heavy intermediates (grid evaluations, simulation caches).
# NOTE deliberate policy: data/ (frozen inputs + MANIFEST.json) and
# results/ (small deterministic estimation outputs) ARE tracked.
scratch/

# Secrets
.env
.env.*

# Exposure embedding cache (large, machine-local; from the retired evaluator)
data/_exposure_cache/

# Raw geometry-of-work exports, copied in to rebuild the projection basis.
# Large (task_embeddings.npy > 100 MB) and machine-local; only the validated
# data/geometry_projection.npz is tracked.
data/_geometry_raw/

# Startup embedding cache (rebuilt from the corpus on first run of 21).
results/startup_embeddings.npz

# Third-party YC corpus text (regenerated by scripts/fetch_startups.py).
data/startups_ycombinator.csv


# LaTeX build artifacts (latexmk/pdflatex/biber); the .tex, .bib, and
# figure sources are tracked, the compiled outputs are regenerable.
paper/*.aux
paper/*.bbl
paper/*.bcf
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.run.xml
paper/*.toc
#paper/*.pdf

# Generated CLD / stock-flow outputs
outputs/

# editor crash artifacts
*-SAVE-ERROR
